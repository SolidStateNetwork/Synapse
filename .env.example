# ==============================================================================
# Synapse — Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# --- Core Gateway (mTLS Yamux Hub & Internal HTTP API) ---
SYNAPSE_DATA_DIR=/var/lib/synapse
SYNAPSE_TUNNEL_PORT=8443
SYNAPSE_GATEWAY_HTTP_ADDR=:8081
SYNAPSE_DEBUG=0

# --- Core WebUI (Next.js Control Center) ---
PORT=3000
HOSTNAME=0.0.0.0
CORE_GATEWAY_URL=http://127.0.0.1:8081
NEXT_PUBLIC_GATEWAY_URL=
SYNAPSE_VAULT_DIR=/var/lib/synapse/projects
SYNAPSE_CARTRIDGES_DIR=./cartridges
# Master passphrase for the AES-256-GCM Brain Vault & Provider Key Store
SYNAPSE_MASTER_KEY=change-me-in-production-aes-256-gcm-master-key

# --- Optional: AI Provider Keys (can also be configured in WebUI -> Settings) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
