# ==============================================================================
# Synapse — Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# --- Core Gateway (mTLS Yamux Hub & Internal HTTP API) ---
SYNAPSE_DATA_DIR=/var/lib/synapse
SYNAPSE_DEBUG=0
# Public hostname or IP used when generating Axon enrollment tokens
SYNAPSE_PUBLIC_HOST=127.0.0.1

# --- Core WebUI (Next.js Control Center) ---
PORT=3000
HOSTNAME=0.0.0.0
SYNAPSE_GATEWAY_URL=http://127.0.0.1:8081
# Master passphrase for the AES-256-GCM Brain Vault & Provider Key Store
SYNAPSE_VAULT_SECRET=change-me-in-production-min-32-chars-secret-key

# --- Optional: AI Provider Keys (can also be configured in WebUI -> Settings) ---
# GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
